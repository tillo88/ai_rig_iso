[Unit]
Description=AI Rig - First-boot autopopulate
After=ai-rig-stage-network.service local-fs.target
Wants=ai-rig-stage-network.service
ConditionPathExists=!/var/lib/ai-rig/populate-cache-done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ai-rig-first-boot.sh
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
