# /etc/ai-rig-bot/config.env
# Permessi consigliati: chmod 600, chown tillo:tillo (contiene il BOT_TOKEN)

BOT_TOKEN="RECUPERA_DA_config/rig.env_SUL_TUO_PROGETTO_ISO"
RIG_MAC="AA:BB:CC:DD:EE:FF"
RIG_IP="192.168.1.100"
RIG_API_PORT="8080"
RIG_SSH_USER="tillo"
RIG_SSH_KEY="/home/tillo/.ssh/ai_rig"          # chiave privata del bot, la .pub va in cache/ai-rig-bot.pub del progetto ISO
RIG_VERIFY_LOG="/var/log/ai-rig-verify.log"

# Chi puo' comandare il bot. ID numerico Telegram (consigliato, immutabile) — scrivi
# a @userinfobot su Telegram per ottenere il tuo. Separati da virgola.
ALLOWED_CHAT_IDS="CHANGEME_TUO_CHAT_ID"

# --- Cold boot al cambio ruolo (2026-07-15) ---
# Con 7 GPU il reboot caldo puo' bloccarsi sul logo MSI (reset PCIe incompleto
# dopo stress). Il cambio ruolo fa: poweroff -> attesa offline -> COLD_BOOT_WAIT
# secondi -> WOL ripetuto. Default gia' buoni: scommentare solo per cambiare.
#COLD_BOOT_WAIT="60"      # secondi di scarica/assestamento PCIe a rig spento
#OFFLINE_TIMEOUT="180"     # max attesa che il rig risulti davvero spento
#ONLINE_TIMEOUT="300"      # max attesa ping dopo il WOL
#ROLE_TIMEOUT="420"          # max attesa conferma del ruolo via SSH
#API_READY_TIMEOUT="900"     # max attesa API/modello dopo conferma ruolo
#MAX_DESTRUCTIVE_COMMAND_AGE="180"  # ignora comandi vecchi dopo restart
#WOL_REPEAT="3"            # magic packet ripetuti (2s di distanza)

# Fase B (opzionale, sperimentale) — vedi README-netboot.md. Lascia false finche'
# non hai VERIFICATO manualmente che il tuo GRUB ha i moduli net/efinet/tftp.
ENABLE_NETBOOT_SELECT="false"
TFTP_GRUB_TARGET_FILE="/srv/tftp/grub_target"
