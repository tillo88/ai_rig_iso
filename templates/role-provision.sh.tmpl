#!/bin/bash
# =============================================================================
# STAGE 4/4 — Provisioning ruolo: __ROLE_NAME__
# =============================================================================
set -e
exec >> /var/log/ai-rig-stage-role.log 2>&1
echo "=== Stage 4 (ruolo __ROLE_NAME__) - $(date) ==="

mkdir -p /var/lib/ai-rig /etc/ai-rig /opt/models/__ROLE_NAME__ /opt/ai-rig/kv-sessions
if [ -f /var/lib/ai-rig/stage-role-done ]; then
    echo "Stage ruolo gia' completato, esco."
    exit 0
fi

echo "__ROLE_NAME__" > /etc/ai-rig/role

# MOVE (non copy): /opt/cache e /opt/models sono sullo STESSO disco -> il mv e'
# istantaneo e NON crea un doppione da ~25-30GB (era la causa del disco pieno).
# Idempotente: se il modello e' gia' in /opt/models non fa nulla.
MODEL_SRC="/opt/cache/models/__ROLE_NAME__/__ROLE_MODEL_FILE__"
MODEL_DST="/opt/models/__ROLE_NAME__/__ROLE_MODEL_FILE__"
if [ -f "$MODEL_DST" ]; then
    echo "Modello gia' presente in $MODEL_DST."
elif [ -f "$MODEL_SRC" ]; then
    mv "$MODEL_SRC" "$MODEL_DST"
else
    echo "!!! Modello non trovato ne' in $MODEL_DST ne' in $MODEL_SRC — copialo in cache/models/__ROLE_NAME__/ e ricostruisci la ISO." >&2
fi

MMPROJ_DST=""
if [ -n "__ROLE_MMPROJ_FILE__" ]; then
    MMPROJ_SRC="/opt/cache/models/__ROLE_NAME__/__ROLE_MMPROJ_FILE__"
    MMPROJ_DST="/opt/models/__ROLE_NAME__/__ROLE_MMPROJ_FILE__"
    if [ -f "$MMPROJ_DST" ]; then
        :   # gia' presente
    elif [ -f "$MMPROJ_SRC" ]; then
        mv "$MMPROJ_SRC" "$MMPROJ_DST"
    else
        echo "!!! mmproj non trovato in $MMPROJ_SRC" >&2
        MMPROJ_DST=""
    fi
fi

cat > "/etc/ai-rig/__ROLE_NAME__.env" << EOFENV
ROLE_NAME=__ROLE_NAME__
ROLE_MODEL_PATH=${MODEL_DST}
ROLE_MMPROJ_PATH=${MMPROJ_DST}
ROLE_LLAMA_PORT=__ROLE_LLAMA_PORT__
ROLE_CTX_SIZE=__ROLE_CTX_SIZE__
ROLE_TEMP=__ROLE_TEMP__
ROLE_TOP_P=__ROLE_TOP_P__
ROLE_REPEAT_PENALTY=__ROLE_REPEAT_PENALTY__
ROLE_EXTRA_ARGS="__ROLE_EXTRA_ARGS__"
# Reasoning / chat template (vuoti = default: reasoning off, jinja off)
ROLE_REASONING_FORMAT=__ROLE_REASONING_FORMAT__
ROLE_REASONING_BUDGET=__ROLE_REASONING_BUDGET__
ROLE_CHAT_TEMPLATE_KWARGS='__ROLE_CHAT_TEMPLATE_KWARGS__'
ROLE_JINJA=__ROLE_JINJA__
# Derivati da LLAMA_FLAVOR (config/rig.env) — riscritti da swap-llama-flavor.sh
LLAMA_FLAVOR=__LLAMA_FLAVOR__
ROLE_CACHE_TYPE_K=__LLAMA_CACHE_TYPE_K__
ROLE_CACHE_TYPE_V=__LLAMA_CACHE_TYPE_V__
ROLE_FLASH_ATTN=__LLAMA_FLASH_ATTN__
EOFENV

# Python venv dedicato al ruolo (requirements/__ROLE_NAME__.txt + requirements/common.txt)
if [ -f /opt/cache/requirements/__ROLE_NAME__.txt ]; then
    python3 -m venv "/opt/venv-__ROLE_NAME__"
    "/opt/venv-__ROLE_NAME__/bin/pip" install --upgrade pip -q
    [ -f /opt/cache/requirements/common.txt ] && "/opt/venv-__ROLE_NAME__/bin/pip" install -q -r /opt/cache/requirements/common.txt
    "/opt/venv-__ROLE_NAME__/bin/pip" install -q -r /opt/cache/requirements/__ROLE_NAME__.txt
    chown -R tillo:tillo "/opt/venv-__ROLE_NAME__"
fi

chmod +x /usr/local/bin/start-llama-__ROLE_NAME__.sh 2>/dev/null || true
systemctl daemon-reload
systemctl enable "llama-server@__ROLE_NAME__.service"
systemctl start "llama-server@__ROLE_NAME__.service" || echo "!!! avvio llama-server fallito, controlla journalctl" >&2

touch /var/lib/ai-rig/stage-role-done
echo "=== Stage 4 completato - $(date) ==="

# Verifica finale (best effort, non blocca il boot se fallisce)
/usr/local/bin/90-verify.sh || true
