#!/bin/bash
# Ruolo: DEVIN — coding/debug agent, reasoning/planning/decoding model
ROLE_NAME="devin"
ROLE_HOSTNAME="tilloGPT-devin"
ROLE_DISK_SERIAL_VAR="DEVIN_DISK_SERIAL"     # nome variabile da leggere in disks.env
ROLE_DISK_BYPATH_VAR="DEVIN_DISK_BYPATH"

ROLE_MODEL_FILE="Ornith-1.0-35B-A3B-MXFP4_MOE_Q8_0_F16-Imatrix.gguf"   # jashepp, 20.7GB, MoE 35B/A3B, coding-agent
ROLE_MMPROJ_FILE=""                          # vuoto = nessun mmproj per questo ruolo

ROLE_LLAMA_PORT=8080
ROLE_CTX_SIZE=32768

# Sampling CONSIGLIATO da jashepp (README Ornith agg. 2026-07-17: "no more
# looping"). Loop-prevention + DRY sampler (protegge indentazione/boilerplate).
# I knob HARDWARE di jashepp (tensor-split, n-gpu-layers, fit, batch) NON si
# copiano: le sue sono 2 GPU, il rig ne ha 7 con split calcolato a ogni boot.
ROLE_TEMP=0.55
ROLE_TOP_P=0.90
ROLE_REPEAT_PENALTY=1.08
ROLE_EXTRA_ARGS="--top-k 15 --min-p 0.12 --presence-penalty 0.00 --dry-multiplier 0.8 --dry-base 1.75 --dry-allowed-length 3 --dry-penalty-last-n 1024 --samplers top_k;top_p;min_p;temp;dry --no-warmup --slot-save-path /opt/ai-rig/kv-sessions"

# Reasoning ON (jashepp: "always keep thinking enabled, better quality").
# reasoning-format auto → il thinking va nel campo reasoning_content dell'API,
# il content resta pulito per l'harness di devin_ai_ide. Ornith VUOLE --jinja.
# NB da ri-verificare al primo run: che l'harness legga solo `content` e il
# thinking non gli finisca dentro (se dà noia, ROLE_REASONING_FORMAT="none").
ROLE_REASONING_FORMAT="auto"
ROLE_REASONING_BUDGET=20480
ROLE_CHAT_TEMPLATE_KWARGS='{"enable_thinking":true}'
ROLE_JINJA=1

ROLE_APT_FILE="packages/devin.apt"
ROLE_PIP_FILE="requirements/devin.txt"
