# Copia in config/teacher-bot.env (file locale NON versionato) e compila.
BOT_TOKEN="CHANGEME_ROTATE_TOKEN"
ALLOWED_CHAT_IDS="CHANGEME_CHAT_ID"
LLAMA_URL="http://localhost:8080"
LLAMA_SERVICE="llama-server@teacher.service"
