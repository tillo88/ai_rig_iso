#!/bin/bash
# config/shared-disk.env — 4° disco condiviso tra i 3 ruoli
# (AutoMem + Understory/OKF + sessioni KV + modelli)

# --- identita' del disco -----------------------------------------------------
# UUID del filesystem: e' l'identita' PRIMARIA. Sopravvive a cambio di
# enclosure, cambio di porta e ri-enumerazione; il serial dell'hardware no.
# Dopo l'incidente del 2026-08-10 (OP-DEVIN-USB-ASMEDIA-RESET-002) il disco si
# e' ripresentato con un device diverso: solo lo UUID ha retto.
SHARED_DISK_UUID="d22a821d-5352-44e1-921e-1dff9e666ce0"

# Serial interno dell'NVMe: usato SOLO come ultima risorsa, per riconoscere un
# disco nuovo da inizializzare al primo boot. Non e' piu' l'identita' operativa.
# Storico: quando questo valore fu scritto l'enclosure era Realtek; oggi e' un
# MAIWO/ASMedia 174c:0c16 e questo serial non viene piu' agganciato.
SHARED_DISK_SERIAL="2210VC0S036H0163"

SHARED_MOUNT_PATH="/mnt/ai-rig-shared"

# Se true (default) l'assenza del disco fa FALLIRE ai-rig-stage-shareddisk
# invece di farlo uscire 0 sembrando riuscito. Un rig senza 4° disco mette
# false: cosi' il silenzio e' una scelta dichiarata, non un difetto nascosto.
SHARED_DISK_REQUIRED=true

# --- Understory --------------------------------------------------------------
# Understory e' un sidecar sperimentale: stessa memoria Markdown/OKF per tutti
# i ruoli, ma AutoMem resta installato come fallback durante il collaudo.
ENABLE_UNDERSTORY=true
UNDERSTORY_IMAGE="ghcr.io/thecodacus/understory:latest"
UNDERSTORY_PORT=3800
# Sicuro per default: accesso dal PC tramite tunnel SSH
# ssh -L 3800:localhost:3800 tillo@192.168.1.100
UNDERSTORY_BIND_HOST="127.0.0.1"
# L'immagine upstream 0.1.0 non contiene il binario git. I commit sono quindi
# eseguiti in sicurezza dall'host tramite ai-rig-understory-commit.timer.
UNDERSTORY_GIT_AUTOCOMMIT=false

# --- Librarian ---------------------------------------------------------------
# Librarian: gateway MCP con quality gate davanti a Understory.
LIBRARIAN_BIND_HOST="127.0.0.1"
LIBRARIAN_PORT=3810
LIBRARIAN_UNDERSTORY_URL="http://127.0.0.1:3800"
