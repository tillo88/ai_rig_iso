#cloud-config
# =============================================================================
# nocloud/auto/user-data — voce "Install AI Rig (AUTO)".
# Autoinstall ROLE-AGNOSTIC: la early-command select-next-role.sh sceglie il
# prossimo ruolo non installato e riscrive __ROLE__ + __TARGET_SERIAL__ qui
# (subiquity ri-legge /autoinstall.yaml dopo le early-commands). NON modificare
# i due segnaposto a mano: sono riempiti all'install.
# Full mode: abilita anche ai-rig-first-boot (autopopulate) e ai-rig-finalize
# (motore della catena). I 3 nocloud/<ruolo> manuali restano come fallback.
# =============================================================================
autoinstall:
  version: 1
  locale: it_IT.UTF-8
  keyboard:
    layout: it
  early-commands:
    # Sceglie il prossimo ruolo (whitelist 3 seriali, 4TB richiesto) e riscrive
    # __ROLE__/__TARGET_SERIAL__ in /autoinstall.yaml. Se il 4TB manca o i ruoli
    # sono tutti fatti, ABORTA l'install (nessun disco toccato).
    - /cdrom/rig-common/scripts/select-next-role.sh
  network:
    version: 2
    ethernets:
      any-en:
        match:
          name: "en*"
        dhcp4: true
        optional: true
  storage:
    config:
      - type: disk
        id: disk0
        match:
          serial: "*__TARGET_SERIAL__*"
        ptable: gpt
        wipe: superblock-recursive
        grub_device: true
        preserve: false
      - type: partition
        id: bios-grub-partition
        device: disk0
        size: 1M
        flag: bios_grub
      - type: partition
        id: esp-partition
        device: disk0
        size: 512M
        flag: boot
        grub_device: true
      - type: partition
        id: boot-partition
        device: disk0
        size: 1G
      - type: partition
        id: root-partition
        device: disk0
        size: -1
      - type: format
        id: esp-format
        volume: esp-partition
        fstype: fat32
      - type: format
        id: boot-format
        volume: boot-partition
        fstype: ext4
      - type: format
        id: root-format
        volume: root-partition
        fstype: ext4
      - type: mount
        id: root-mount
        device: root-format
        path: /
      - type: mount
        id: boot-mount
        device: boot-format
        path: /boot
      - type: mount
        id: esp-mount
        device: esp-format
        path: /boot/efi
  identity:
    hostname: tilloGPT-__ROLE__
    username: tillo
    password: '$6$tilloGPTsalt$y24xF6.3wreu9PsHe8ae.9jDTfTNN7Q33Cz9SFA68IJJCpe5GkoWtWr1sKkYnMghO.5/wl3bg2tqwlS13abYB.'
  ssh:
    install-server: true
    allow-pw: true
  packages:
    - build-essential
    - git
    - cmake
    - curl
    - wget
    - htop
    - nvtop
    - pciutils
    - usbutils
    - lm-sensors
    - smartmontools
    - dkms
    - libvulkan1
    - software-properties-common
    - linux-headers-generic
    - wakeonlan
    - ethtool
    - bc
    - os-prober
    - openssh-server
    - python3-venv
    - python3-pip
    - docker.io
    - docker-compose-v2
    - parted
    - net-tools
    - iproute2
    - iputils-ping
    - dnsutils
    - rsync
    - zip
    - unzip
    - jq
    - gnupg
    - ca-certificates
    - linux-firmware
    - gdisk
    - mdadm
    - lvm2
    - tmux
    - ripgrep
    - fd-find
    - nodejs
    - npm
  late-commands:
    - mkdir -p /target/opt/cache /target/opt/ai-rig /target/etc/ai-rig /target/usr/local/bin
    - curtin in-target --target=/target -- bash -c 'echo __ROLE__ > /etc/ai-rig/role'
    - cp /cdrom/cache/BUILD_ID /target/etc/ai-rig/build-id
    - cp -a /cdrom/cache/config /target/opt/cache/
    - cp -a /cdrom/cache/requirements /target/opt/cache/
    - cp -a /cdrom/cache/scripts /target/opt/cache/
    - cp /cdrom/cache/ai-rig-bot.pub /target/opt/cache/ 2>/dev/null || true
    - cp -a /cdrom/rig-common/scripts/. /target/usr/local/bin/
    - cp -a /cdrom/rig-roles/__ROLE__/scripts/. /target/usr/local/bin/
    - curtin in-target --target=/target -- bash -c 'chmod +x /usr/local/bin/*.sh'
    - cp -a /cdrom/rig-common/systemd/. /target/etc/systemd/system/
    - cp -a /cdrom/rig-roles/__ROLE__/systemd/. /target/etc/systemd/system/
    - >-
      curtin in-target --target=/target -- bash -c '
      if [ -f /opt/cache/config/__ROLE__-bot.env ]; then
      mkdir -p /etc/__ROLE__-bot;
      cp /opt/cache/config/__ROLE__-bot.env /etc/__ROLE__-bot/config.env;
      owner=tillo; [ "__ROLE__" = teacher ] && owner=root;
      chown "$owner:$owner" /etc/__ROLE__-bot/config.env;
      chmod 600 /etc/__ROLE__-bot/config.env;
      else echo "nessun config/__ROLE__-bot.env: token bot da mettere a mano post-install"; fi'
    - >-
      curtin in-target --target=/target -- bash -c '
      mkdir -p /home/tillo/.ssh && chmod 700 /home/tillo/.ssh;
      if [ -f /opt/cache/ai-rig-bot.pub ]; then
      cat /opt/cache/ai-rig-bot.pub >> /home/tillo/.ssh/authorized_keys;
      chmod 600 /home/tillo/.ssh/authorized_keys;
      fi;
      chown -R tillo:tillo /home/tillo/.ssh'
    - >-
      curtin in-target --target=/target -- bash -c '
      printf "%s\n" "tillo ALL=(root) NOPASSWD: /usr/local/bin/ai-rig-select-role.sh *, /usr/bin/systemctl poweroff, /usr/bin/systemctl reboot, /usr/sbin/grub-reboot *, /usr/local/bin/populate-cache.sh" > /etc/sudoers.d/ai-rig-bot;
      chmod 0440 /etc/sudoers.d/ai-rig-bot;
      visudo -cf /etc/sudoers.d/ai-rig-bot || rm -f /etc/sudoers.d/ai-rig-bot'
    - curtin in-target --target=/target -- systemctl daemon-reload
    # LEGGERE + full-mode: rete, WOL, 4o disco, SMART, ruolo, backup, bot del
    # ruolo, + first-boot (autopopulate) + finalize (motore catena). Le PESANTI
    # le abilita ai-rig-first-boot via populate-cache.
    - curtin in-target --target=/target -- systemctl enable
        ai-rig-stage-network.service ai-rig-stage-wol.service
        ai-rig-stage-shareddisk.service ai-rig-stage-smart.service
        ai-rig-stage-role.service ai-rig-backup.timer
        ai-rig-first-boot.service ai-rig-finalize.service
        __ROLE__-bot.service
