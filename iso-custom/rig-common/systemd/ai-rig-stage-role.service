[Unit]
Description=AI Rig Stage 4 - Role provisioning (model + llama-server)
After=ai-rig-stage-gpudetect.service ai-rig-stage-network.service ai-rig-stage-wol.service
Requires=ai-rig-stage-gpudetect.service
# NB: role NON dipende da automem/understory/librarian. La memoria e' opzionale e
# fail-soft (docker/4o disco possono mancare o essere lenti): il modello deve
# salire comunque. Prima c'era After=automem -> un automem lento/appeso ritardava
# o bloccava il provisioning del modello (fino a 600s). Disaccoppiato 2026-07-17.
ConditionPathExists=/var/lib/ai-rig/stage-gpudetect-done
ConditionPathExists=!/var/lib/ai-rig/stage-role-done
[Service]
Type=oneshot
ExecStart=/usr/local/bin/role-provision.sh
RemainAfterExit=yes
TimeoutStartSec=1200
[Install]
WantedBy=multi-user.target
